# Ayu AI local-first settings. No API key is required for basic/local mode.
AYU_MODE=local
AYU_MEMORY_ENABLED=true
# AYU_DATABASE=~/.ayu-ai/ayu.sqlite3
# AYU_LOCAL_MODEL=/absolute/path/to/compatible-model.gguf
# AYU_LLAMA_CLI=llama-cli
# AYU_LOCAL_TIMEOUT=300

# Optional remote integration. Only configure if you explicitly want provider calls.
# AYU_MODE=remote
# AYU_API_KEY=replace-with-your-provider-key
# AYU_BASE_URL=https://api.openai.com/v1
# AYU_MODEL=provider-supported-model-id

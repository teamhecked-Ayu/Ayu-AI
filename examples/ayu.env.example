# Ayu AI local-first settings. Basic/local features need no credentials.
AYU_MODE=local
AYU_MEMORY_ENABLED=true
# AYU_DATABASE=~/.ayu-ai/ayu.sqlite3
# AYU_LOCAL_MODEL=/absolute/path/to/compatible-model.gguf
# AYU_LLAMA_CLI=llama-cli
# AYU_LOCAL_TIMEOUT=300

# Select at most one remote inference provider and keep real keys in a private .env.
# AYU_MODE=remote
# AYU_PROVIDER=openai
# OPENAI_API_KEY=placeholder-not-a-real-key
# AYU_MODEL=your-openai-model-id
# Or select Anthropic instead:
# AYU_PROVIDER=anthropic
# ANTHROPIC_API_KEY=placeholder-not-a-real-key
# ANTHROPIC_MODEL=your-anthropic-model-id
# For OpenAI-compatible providers use AYU_PROVIDER=openai-compatible, AYU_API_KEY,
# AYU_BASE_URL=https://provider.example/v1, and AYU_MODEL.
# AYU_API_KEY=placeholder-not-a-real-key

# Independent NewsAPI metadata; disabled unless explicitly enabled and called with --allow-network.
# AYU_NEWSAPI_ENABLED=true
# NEWSAPI_API_KEY=placeholder-not-a-real-key

# Ayu AI credential template: replace placeholder values locally; never commit a real key.
AYU_MODE=local
AYU_MEMORY_ENABLED=true
AYU_DATABASE=~/.ayu-ai/ayu.sqlite3
# Optional local inference; models are never downloaded automatically.
# AYU_LOCAL_MODEL=/absolute/path/to/compatible-model.gguf
# AYU_LOCAL_BACKEND=llama-server
# AYU_LLAMA_SERVER_URL=http://127.0.0.1:9931
# AYU_LOCAL_MODEL_ID=optional-exact-id-if-server-reports-multiple-models
# AYU_LOCAL_MAX_INPUT_CHARS=65536

# Optional OpenAI-compatible remote mode (select exactly one provider).
# AYU_MODE=remote
# AYU_PROVIDER=openai
OPENAI_API_KEY=placeholder-not-a-real-key
# AYU_MODEL=your-openai-model-id

# Optional Anthropic alternative (select AYU_PROVIDER=anthropic instead).
ANTHROPIC_API_KEY=placeholder-not-a-real-key
# ANTHROPIC_MODEL=your-anthropic-model-id

# Optional OpenAI-compatible service using the generic credential variable.
AYU_API_KEY=placeholder-not-a-real-key
# AYU_PROVIDER=openai-compatible
# AYU_BASE_URL=https://provider.example/v1
# AYU_MODEL=provider-supported-model-id

# Optional independent NewsAPI.org metadata search (never used for inference).
NEWSAPI_API_KEY=placeholder-not-a-real-key
AYU_NEWSAPI_ENABLED=false
